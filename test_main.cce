#include "acl/acl.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct KernelArgs {
    unsigned int a;
    unsigned int b;
    unsigned int *Device;
};

extern __global__ __aicpu__ unsigned int KernelAicpu(void *args);

static const size_t SPACESIZE = 4096;

int main(int argc, char *argv[]) {
    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream;
    aclrtCreateStream(&stream);

    void *OutputDevice = nullptr;
    aclrtMalloc((void **)&OutputDevice, SPACESIZE, ACL_MEM_MALLOC_HUGE_FIRST);

    void *InputHost = malloc(SPACESIZE);
    memset(InputHost, 0, SPACESIZE);
    aclrtMemcpy(OutputDevice, SPACESIZE, InputHost, SPACESIZE, ACL_MEMCPY_HOST_TO_DEVICE);

    KernelArgs args;
    args.Device = (unsigned int *)OutputDevice;
    args.a = 1;
    args.b = 2;

    KernelAicpu<<<1, nullptr, stream>>>(&args, sizeof(KernelArgs));
    aclrtSynchronizeStream(stream);

    unsigned int *OutputHost = nullptr;
    aclrtMallocHost((void **)&OutputHost, SPACESIZE);
    aclrtMemcpy(OutputHost, SPACESIZE, OutputDevice, SPACESIZE, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtSynchronizeStream(stream);

    printf("Get Result in host: 0x%08x\n", *OutputHost);

    aclrtFreeHost(OutputHost);
    free(InputHost);
    aclrtFree(OutputDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
