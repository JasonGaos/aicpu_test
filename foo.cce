#include "acl/acl.h"

extern __global__ __aicpu__ int foo_aicpu(void *arg);

int main() {
    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream;
    aclrtCreateStream(&stream);

    int dummy = 0;
    foo_aicpu<<<1, nullptr, stream>>>(&dummy, sizeof(dummy));
    aclrtSynchronizeStream(stream);

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
