#include "aicpu_api.h"
#include "bench_target.h"

// The AICPU device build needs the implementation in the same translation unit.
// Pull in the AES implementation first, then the thin benchmark wrappers.
#include "../aes/aes.c"
#include "bench_target.c"

struct BenchArgs {
    const uint8 *key;
    const uint8 *iv;
    const uint8 *input;
    uint8 *output;
    size_t msg_len;
    int repeat;
};

static int ValidateArgs(const BenchArgs *cfg) {
    return cfg != nullptr && cfg->key != nullptr && cfg->iv != nullptr && cfg->input != nullptr &&
           cfg->output != nullptr && cfg->msg_len != 0 && cfg->repeat > 0;
}

__global__ __aicpu__ int BenchEncryptKernel(void *arg) {
    BenchArgs *cfg = (BenchArgs *)arg;
    if (!ValidateArgs(cfg)) {
        return 1;
    }

    for (int i = 0; i < cfg->repeat; ++i) {
        func(cfg->key, cfg->iv, cfg->input, cfg->output, cfg->msg_len);
    }
    return 0;
}

__global__ __aicpu__ int BenchDecryptKernel(void *arg) {
    BenchArgs *cfg = (BenchArgs *)arg;
    if (!ValidateArgs(cfg)) {
        return 1;
    }

    for (int i = 0; i < cfg->repeat; ++i) {
        decryp(cfg->key, cfg->iv, cfg->input, cfg->output, cfg->msg_len);
    }
    return 0;
}
