#include "acl/acl.h"
#include "bench_target.h"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct BenchArgs {
    const uint8 *key;
    const uint8 *iv;
    const uint8 *plaintext;
    uint8 *ciphertext;
    size_t msg_len;
    int repeat;
};

extern __global__ __aicpu__ int BenchKernel(void *arg);

static double ElapsedUs(const struct timespec *start, const struct timespec *end) {
    return (double)(end->tv_sec - start->tv_sec) * 1000000.0 +
           (double)(end->tv_nsec - start->tv_nsec) / 1000.0;
}

static int CheckAcl(const char *step, aclError err) {
    if (err != ACL_ERROR_NONE) {
        fprintf(stderr, "%s failed, aclError=%d\n", step, (int)err);
        return 0;
    }
    return 1;
}

int main() {
    const size_t key_bytes = 32;
    const size_t iv_bytes = 16;
    const size_t msg_len = 64;
    const int repeat = 1;
    const int warmups = 1;
    const int launches = 1;
    const size_t output_bytes = msg_len * sizeof(uint8);

    uint8 *host_key = (uint8 *)malloc(key_bytes);
    uint8 *host_iv = (uint8 *)malloc(iv_bytes);
    uint8 *host_plaintext = (uint8 *)malloc(msg_len);
    if (host_key == nullptr || host_iv == nullptr || host_plaintext == nullptr) {
        fprintf(stderr, "malloc input buffers failed\n");
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    for (size_t i = 0; i < key_bytes; ++i) {
        host_key[i] = (uint8)(0x10 + (i & 0x0f));
    }
    for (size_t i = 0; i < iv_bytes; ++i) {
        host_iv[i] = (uint8)(0x20 + i);
    }
    for (size_t i = 0; i < msg_len; ++i) {
        host_plaintext[i] = (uint8)(i & 0xff);
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }
    if (!CheckAcl("aclrtSetDevice", aclrtSetDevice(0))) {
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }
    {
        aclError timeout_err = aclrtSetOpExecuteTimeOut(300);
        if (timeout_err != ACL_ERROR_NONE) {
            fprintf(stderr, "warning: aclrtSetOpExecuteTimeOut failed, aclError=%d\n",
                    (int)timeout_err);
        }
    }

    aclrtStream stream = nullptr;
    if (!CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream))) {
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    uint8 *device_key = nullptr;
    uint8 *device_iv = nullptr;
    uint8 *device_plaintext = nullptr;
    uint8 *device_ciphertext = nullptr;
    if (!CheckAcl("aclrtMalloc key",
                  aclrtMalloc((void **)&device_key, key_bytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !CheckAcl("aclrtMalloc iv",
                  aclrtMalloc((void **)&device_iv, iv_bytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !CheckAcl("aclrtMalloc plaintext",
                  aclrtMalloc((void **)&device_plaintext, msg_len, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !CheckAcl("aclrtMalloc ciphertext",
                  aclrtMalloc((void **)&device_ciphertext, output_bytes,
                              ACL_MEM_MALLOC_HUGE_FIRST))) {
        if (device_key != nullptr) {
            aclrtFree(device_key);
        }
        if (device_iv != nullptr) {
            aclrtFree(device_iv);
        }
        if (device_plaintext != nullptr) {
            aclrtFree(device_plaintext);
        }
        if (device_ciphertext != nullptr) {
            aclrtFree(device_ciphertext);
        }
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    if (!CheckAcl("aclrtMemcpy key H2D",
                  aclrtMemcpy(device_key, key_bytes, host_key, key_bytes,
                              ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !CheckAcl("aclrtMemcpy iv H2D",
                  aclrtMemcpy(device_iv, iv_bytes, host_iv, iv_bytes,
                              ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !CheckAcl("aclrtMemcpy plaintext H2D",
                  aclrtMemcpy(device_plaintext, msg_len, host_plaintext, msg_len,
                              ACL_MEMCPY_HOST_TO_DEVICE))) {
        aclrtFree(device_ciphertext);
        aclrtFree(device_plaintext);
        aclrtFree(device_iv);
        aclrtFree(device_key);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    BenchArgs args;
    args.key = device_key;
    args.iv = device_iv;
    args.plaintext = device_plaintext;
    args.ciphertext = device_ciphertext;
    args.msg_len = msg_len;
    args.repeat = repeat;

    for (int i = 0; i < warmups; ++i) {
        BenchKernel<<<1, nullptr, stream>>>(&args, sizeof(args));
    }
    if (!CheckAcl("aclrtSynchronizeStream warmup", aclrtSynchronizeStream(stream))) {
        aclrtFree(device_ciphertext);
        aclrtFree(device_plaintext);
        aclrtFree(device_iv);
        aclrtFree(device_key);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    struct timespec start;
    struct timespec end;
    clock_gettime(CLOCK_MONOTONIC, &start);
    for (int i = 0; i < launches; ++i) {
        BenchKernel<<<1, nullptr, stream>>>(&args, sizeof(args));
    }
    if (!CheckAcl("aclrtSynchronizeStream benchmark", aclrtSynchronizeStream(stream))) {
        aclrtFree(device_ciphertext);
        aclrtFree(device_plaintext);
        aclrtFree(device_iv);
        aclrtFree(device_key);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }
    clock_gettime(CLOCK_MONOTONIC, &end);

    uint8 *host_ciphertext = nullptr;
    if (!CheckAcl("aclrtMallocHost", aclrtMallocHost((void **)&host_ciphertext, output_bytes))) {
        aclrtFree(device_ciphertext);
        aclrtFree(device_plaintext);
        aclrtFree(device_iv);
        aclrtFree(device_key);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    if (!CheckAcl("aclrtMemcpy ciphertext D2H",
                  aclrtMemcpy(host_ciphertext, output_bytes, device_ciphertext, output_bytes,
                              ACL_MEMCPY_DEVICE_TO_HOST))) {
        aclrtFreeHost(host_ciphertext);
        aclrtFree(device_ciphertext);
        aclrtFree(device_plaintext);
        aclrtFree(device_iv);
        aclrtFree(device_key);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_plaintext);
        free(host_iv);
        free(host_key);
        return 1;
    }

    {
        unsigned int checksum = 0;
        double total_us = ElapsedUs(&start, &end);
        double launch_us = total_us / (double)launches;
        double call_ns = (total_us * 1000.0) / ((double)launches * (double)repeat);
        for (size_t i = 0; i < msg_len; ++i) {
            checksum = (checksum * 131u) + host_ciphertext[i];
        }
        printf("ciphertext checksum=0x%08x\n", checksum);
        printf("ciphertext[0..15]=");
        for (size_t i = 0; i < 16 && i < msg_len; ++i) {
            printf(" %02x", host_ciphertext[i]);
        }
        printf("\n");
        printf("total launch+sync time: %.3f us\n", total_us);
        printf("avg per kernel launch: %.3f us\n", launch_us);
        printf("approx avg per func call: %.3f ns\n", call_ns);
    }

    aclrtFreeHost(host_ciphertext);
    aclrtFree(device_ciphertext);
    aclrtFree(device_plaintext);
    aclrtFree(device_iv);
    aclrtFree(device_key);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    free(host_plaintext);
    free(host_iv);
    free(host_key);
    return 0;
}
