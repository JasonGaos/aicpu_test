#include "acl/acl.h"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct BenchArgs {
    const int *input;
    int *output;
    int n;
    int repeat;
};

extern __global__ __aicpu__ int BenchKernel(void *arg);

static double ElapsedUs(const struct timespec *start, const struct timespec *end) {
    return (double)(end->tv_sec - start->tv_sec) * 1000000.0 +
           (double)(end->tv_nsec - start->tv_nsec) / 1000.0;
}

static int CheckAcl(const char *step, aclError err) {
    if (err != ACL_ERROR_NONE) {
        fprintf(stderr, "%s failed, aclError=%d\n", step, (int)err);
        return 0;
    }
    return 1;
}

int main() {
    const int n = 1024;
    const int repeat = 10000;
    const int launches = 20;
    const size_t input_bytes = (size_t)n * sizeof(int);
    const size_t output_bytes = sizeof(int);

    int *host_input = (int *)malloc(input_bytes);
    if (host_input == nullptr) {
        fprintf(stderr, "malloc host_input failed\n");
        return 1;
    }

    for (int i = 0; i < n; ++i) {
        host_input[i] = i & 255;
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        free(host_input);
        return 1;
    }
    if (!CheckAcl("aclrtSetDevice", aclrtSetDevice(0))) {
        aclFinalize();
        free(host_input);
        return 1;
    }

    aclrtStream stream = nullptr;
    if (!CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream))) {
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    int *device_input = nullptr;
    int *device_output = nullptr;
    if (!CheckAcl("aclrtMalloc input",
                  aclrtMalloc((void **)&device_input, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !CheckAcl("aclrtMalloc output",
                  aclrtMalloc((void **)&device_output, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST))) {
        if (device_input != nullptr) {
            aclrtFree(device_input);
        }
        if (device_output != nullptr) {
            aclrtFree(device_output);
        }
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    if (!CheckAcl("aclrtMemcpy H2D",
                  aclrtMemcpy(device_input, input_bytes, host_input, input_bytes,
                              ACL_MEMCPY_HOST_TO_DEVICE))) {
        aclrtFree(device_output);
        aclrtFree(device_input);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    BenchArgs args;
    args.input = device_input;
    args.output = device_output;
    args.n = n;
    args.repeat = repeat;

    for (int i = 0; i < 5; ++i) {
        BenchKernel<<<1, nullptr, stream>>>(&args, sizeof(args));
    }
    if (!CheckAcl("aclrtSynchronizeStream warmup", aclrtSynchronizeStream(stream))) {
        aclrtFree(device_output);
        aclrtFree(device_input);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    struct timespec start;
    struct timespec end;
    clock_gettime(CLOCK_MONOTONIC, &start);
    for (int i = 0; i < launches; ++i) {
        BenchKernel<<<1, nullptr, stream>>>(&args, sizeof(args));
    }
    if (!CheckAcl("aclrtSynchronizeStream benchmark", aclrtSynchronizeStream(stream))) {
        aclrtFree(device_output);
        aclrtFree(device_input);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }
    clock_gettime(CLOCK_MONOTONIC, &end);

    int *host_output = nullptr;
    if (!CheckAcl("aclrtMallocHost", aclrtMallocHost((void **)&host_output, output_bytes))) {
        aclrtFree(device_output);
        aclrtFree(device_input);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    if (!CheckAcl("aclrtMemcpy D2H",
                  aclrtMemcpy(host_output, output_bytes, device_output, output_bytes,
                              ACL_MEMCPY_DEVICE_TO_HOST))) {
        aclrtFreeHost(host_output);
        aclrtFree(device_output);
        aclrtFree(device_input);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        free(host_input);
        return 1;
    }

    {
        double total_us = ElapsedUs(&start, &end);
        double launch_us = total_us / (double)launches;
        double call_ns = (total_us * 1000.0) / ((double)launches * (double)repeat);
        printf("result=%d\n", host_output[0]);
        printf("total launch+sync time: %.3f us\n", total_us);
        printf("avg per kernel launch: %.3f us\n", launch_us);
        printf("approx avg per bench_target_sum call: %.3f ns\n", call_ns);
    }

    aclrtFreeHost(host_output);
    aclrtFree(device_output);
    aclrtFree(device_input);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    free(host_input);
    return 0;
}
